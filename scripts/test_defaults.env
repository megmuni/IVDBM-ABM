# Shared defaults for IVDBM-ABM Slurm test jobs (submit_tests.sh / tests.sbatch).
# See README.md "What to change" (test jobs row) and "Testing on DRAC".

IVDBM_TEST_DEFAULT_ACCOUNT="${IVDBM_TEST_DEFAULT_ACCOUNT:-def-nicoleli}"
IVDBM_TEST_DEFAULT_ARRAY="${IVDBM_TEST_DEFAULT_ARRAY:-0-0}"
IVDBM_TEST_DEFAULT_TIME="${IVDBM_TEST_DEFAULT_TIME:-0-00:30:00}"
IVDBM_TEST_DEFAULT_CPUS="${IVDBM_TEST_DEFAULT_CPUS:-8}"
IVDBM_TEST_DEFAULT_MEM="${IVDBM_TEST_DEFAULT_MEM:-16000M}"
IVDBM_TEST_DEFAULT_PROFILE="${IVDBM_TEST_DEFAULT_PROFILE:-cpu}"
IVDBM_TEST_DEFAULT_SUITE="${IVDBM_TEST_DEFAULT_SUITE:-cpu}"
IVDBM_TEST_BUILD_DIR="${IVDBM_TEST_BUILD_DIR:-build}"

IVDBM_PROFILE_CPU_GPUS="${IVDBM_PROFILE_CPU_GPUS:-}"
IVDBM_PROFILE_GPU_GPUS="${IVDBM_PROFILE_GPU_GPUS:-h100:2}"
