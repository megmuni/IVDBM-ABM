# Shared defaults for IVDBM-ABM Slurm jobs.
# Sourced by scripts/submit_testrun.sh and scripts/testrun.sbatch.
# Simulation values use := so sbatch env exports from submit still win.
# See README.md "Where to set run parameters" for when to edit this file vs CLI flags.

# --- Simulation (exported to testrun.sbatch --> testRun CLI) ---
: "${NUMTICKS:=24}"
: "${WXW:=1}"
: "${WYW:=1}"
: "${WZW:=1}"
: "${INPUTFILE:=configFiles/config_scaffold.txt}"
: "${CHEM_CONFIG:=configFiles/chemical_environment.json}"

# --- submit_testrun.sh defaults (override via CLI) ---
IVDBM_DEFAULT_ACCOUNT="${IVDBM_DEFAULT_ACCOUNT:-def-nicoleli}"
IVDBM_DEFAULT_ARRAY="${IVDBM_DEFAULT_ARRAY:-0-0}"
IVDBM_DEFAULT_TIME="${IVDBM_DEFAULT_TIME:-0-00:05:00}"
IVDBM_DEFAULT_CPUS="${IVDBM_DEFAULT_CPUS:-32}"
IVDBM_DEFAULT_MEM="${IVDBM_DEFAULT_MEM:-32000M}"
IVDBM_DEFAULT_TESTRUN="${IVDBM_DEFAULT_TESTRUN:-build/bin/testRun}"
IVDBM_DEFAULT_PROFILE="${IVDBM_DEFAULT_PROFILE:-gpu}"

# --- Job profiles (--profile cpu|gpu on submit script) ---
IVDBM_PROFILE_CPU_GPUS="${IVDBM_PROFILE_CPU_GPUS:-}"
IVDBM_PROFILE_GPU_GPUS="${IVDBM_PROFILE_GPU_GPUS:-h100:2}"
