# clangd config for the diffusion3d subproject.
#
# The outer CMakeLists.txt sets `-std=c++11`, but this subproject's targets
# require C++17 (e.g. `<filesystem>` in main.cpp, `<catch2/catch.hpp>` and
# structured bindings in the tests). Without a generated compile_commands.json,
# clangd falls back to C++11 and flags valid code as errors. Force C++17 here.

CompileFlags:
  Add:
    - -std=c++17
    - -DGPU_DIFFUSE=1
    - -I/usr/local/cuda/include
  Remove:
    - -std=c++11
    - -std=c++0x
